generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["core", "virtual_office"]
}

// ==================== CORE SCHEMA ====================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  firstName    String
  lastName     String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Custom role (overrides built-in role permissions when set)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  // Relations
  presenceStatus    PresenceStatus?
  checkInRecords    CheckInRecord[]
  userAvatar        UserAvatar?
  bitrixMapping     BitrixUserMapping?
  pushSubscriptions PushSubscription[]
  absenceRecords    AbsenceRecord[]
  holidayOverrides  HolidayOverride[]

  @@schema("core")
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  permissions Json     @default("[]")
  color       String   @default("#6B7280")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@schema("core")
}

enum UserRole {
  ADMIN
  STAFF
  STUDENT
  PROFESSOR

  @@schema("core")
}

model Plugin {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  description String
  route       String?
  icon        String?
  adminOnly   Boolean  @default(false)
  isActive    Boolean  @default(true)
  config      Json?
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("core")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("core")
}

model PluginVersion {
  id          String   @id @default(uuid())
  pluginName  String
  version     String
  backupPath  String
  installedAt DateTime @default(now())

  @@unique([pluginName, version])
  @@schema("core")
}

model PluginMigration {
  id         String   @id @default(uuid())
  pluginName String
  version    String
  fileName   String
  checksum   String
  appliedAt  DateTime @default(now())

  @@unique([pluginName, version])
  @@schema("core")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("core")
}

// ==================== VIRTUAL_OFFICE SCHEMA ====================

model OfficeLayout {
  id              String   @id @default(uuid())
  name            String
  width           Int      @default(40)
  height          Int      @default(30)
  backgroundImage String?
  zones           Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("virtual_office")
}

model UserAvatar {
  id          String    @id @default(uuid())
  userId      String    @unique
  skinColor   String    @default("#F5CBA7")
  hairStyle   HairStyle @default(short)
  hairColor   String    @default("#2C2C2C")
  shirtColor  String    @default("#3498DB")
  accessory   Accessory @default(none)
  emoji       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("virtual_office")
}

enum HairStyle {
  short
  long
  curly
  bald
  ponytail
  mohawk
  afro
  buzz

  @@schema("virtual_office")
}

enum Accessory {
  glasses
  headphones
  hat
  earbuds
  none

  @@schema("virtual_office")
}

model CheckInRecord {
  id           String      @id @default(uuid())
  userId       String
  checkInAt    DateTime    @default(now())
  checkOutAt   DateTime?
  totalMinutes Int?
  source       CheckSource @default(WEB)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkInAt])
  @@index([userId, checkInAt])
  @@schema("virtual_office")
}

enum CheckSource {
  WEB
  BITRIX
  MOBILE

  @@schema("virtual_office")
}

model PresenceStatus {
  id            String         @id @default(uuid())
  userId        String         @unique
  status        OfficeStatus   @default(OFFLINE)
  statusMessage String?
  currentZoneId String?
  defaultZoneId String?
  positionX     Int?
  positionY     Int?
  isCheckedIn   Boolean        @default(false)
  lastActivityAt DateTime      @default(now())
  updatedAt     DateTime       @updatedAt
  justification  String?
  statusStartsAt DateTime?
  statusEndsAt   DateTime?
  meetingId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("virtual_office")
}

enum OfficeStatus {
  AVAILABLE
  IN_MEETING_INTERNAL
  IN_MEETING_EXTERNAL
  FOCUS
  LUNCH
  BRB
  OFFLINE

  @@schema("virtual_office")
}

enum AbsenceType {
  PERMISO
  VACACIONES
  INCAPACIDAD

  @@schema("virtual_office")
}

model AbsenceRecord {
  id            String      @id @default(uuid())
  userId        String
  type          AbsenceType
  startAt       DateTime
  endAt         DateTime
  justification String?
  createdBy     String
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt, endAt])
  @@index([startAt, endAt])
  @@schema("virtual_office")
}

model Holiday {
  id      String   @id @default(uuid())
  date    DateTime @db.Date
  name    String
  country String

  overrides HolidayOverride[]

  @@unique([date, country])
  @@index([country, date])
  @@schema("virtual_office")
}

model HolidayOverride {
  id            String   @id @default(uuid())
  userId        String
  holidayId     String
  newDate       DateTime @db.Date
  justification String
  createdAt     DateTime @default(now())

  holiday Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, holidayId])
  @@index([userId, newDate])
  @@schema("virtual_office")
}

enum InviteState {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@schema("virtual_office")
}

model MeetingInvite {
  id          String      @id @default(uuid())
  meetingId   String
  hostId      String
  inviteeId   String
  state       InviteState @default(PENDING)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@index([inviteeId, state])
  @@index([meetingId])
  @@index([hostId, state])
  @@schema("virtual_office")
}

model UserProfileOverride {
  id            String  @id @default(uuid())
  userId        String  @unique
  managerUserId String?
  country       String?

  @@schema("virtual_office")
}

model BitrixUserMapping {
  id           String   @id @default(uuid())
  userId       String   @unique
  bitrixUserId Int      @unique
  createdAt    DateTime @default(now())
  departmentId     String?
  isDepartmentHead Boolean @default(false)
  country          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("virtual_office")
}
